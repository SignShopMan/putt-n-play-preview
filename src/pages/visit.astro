---
import Base from "../layouts/Base.astro";
import VisitBlock from "../components/VisitBlock.astro";
import business from "../data/business.json";

/*
 * TODO: FAQ answers need owner approval. Only facts from the brand guide are used here.
 * Add FAQPage schema once the FAQ content is approved (brand guide p.16).
 */
const faqs = [
  { q: "Where are you?", a: `${business.address.street} in downtown ${business.address.city}, ${business.address.region}.` },
  { q: "Is everything indoors?", a: "Yes. Mini golf, golf simulators, laser tag, VR, and the multisport arcade are all indoors, so weather never cancels your plans." },
  { q: "How do I book a birthday party?", a: `Call ${business.phone}, or send an inquiry from the Parties page.` },
  { q: "Do you sell gift cards?", a: "Yes. You can buy them online any time." },
  { q: "Can I look around before I come?", a: "Take the 3D virtual tour to walk through the whole place from your couch." },
];
---

<Base
  title="Hours, Directions & Contact | Putt & Play Bellefontaine"
  description="Hours, directions, parking, and contact info for Putt & Play Golf Center at 209 W Columbus Ave in downtown Bellefontaine, Ohio."
>
  <VisitBlock headingLevel="h1" title="Come play." />

  <section class="section pt-0 md:pt-0">
    <div class="container-brand grid gap-8 md:grid-cols-3">
      <div class="card p-6">
        <h2 class="h-card">Call or email</h2>
        <p class="mt-3"><a href={business.phoneHref} class="font-semibold underline">{business.phone}</a></p>
        {/* TODO: verify email with owner */}
        <p><a href={`mailto:${business.email}`} class="underline">{business.email}</a></p>
      </div>
      <div class="card p-6">
        <h2 class="h-card">Parking</h2>
        {/* TODO: owner to provide parking details (street, lot, accessibility) */}
        <p class="mt-3 text-ink/70">Parking details coming soon.</p>
      </div>
      <div class="card p-6">
        <h2 class="h-card">Look around</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={business.links.tour} class="pill bg-gold" target="_blank" rel="noopener">3D tour</a>
          <a href={business.links.facebook} class="pill bg-paper" target="_blank" rel="noopener">Facebook</a>
          <a href={business.links.giftCards} class="pill bg-paper" target="_blank" rel="noopener">Gift cards</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t-[3px] border-ink" aria-labelledby="faq-heading">
    <div class="container-brand max-w-3xl">
      <h2 id="faq-heading" class="h-section">Questions</h2>
      <div class="mt-8 grid gap-4">
        {
          faqs.map((f) => (
            <details class="card group p-0">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 p-5 font-display font-bold">
                {f.q}
                <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full border-[3px] border-ink bg-gold transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-5 pb-5 text-lg leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
