---
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import LockupPanel from "../components/LockupPanel.astro";
import PriceGroup from "../components/PriceGroup.astro";
import Photo from "../components/Photo.astro";
import business from "../data/business.json";
---

<Base
  title="Golf Simulators in Bellefontaine, OH | Putt & Play"
  description="Three indoor golf simulators with 150,000+ courses, driving range and challenge modes, and winter leagues in downtown Bellefontaine, Ohio."
>
  <PageHero
    label="Golf simulators"
    labelColor="fairway"
    title="Tee off all winter."
    lede="Three simulators. 150,000+ courses from around the world. Up to 8 players per booth. Your winter golf season starts here."
    photo="golf-sim"
    photoAlt="Golfer following through on a swing in a simulator bay"
  >
    <Fragment slot="actions">
      <a href={business.phoneHref} class="btn-primary">Call to book a booth</a>
      <a href="#prices" class="btn-secondary">See prices</a>
    </Fragment>
  </PageHero>

  <section class="section border-t-[3px] border-ink bg-fairway/5">
    <div class="container-brand">
      <LockupPanel variant="golf" />
      <div class="mt-14 grid items-center gap-10 md:grid-cols-2">
        <div>
          <h2 class="h-section">150,000+ courses</h2>
          <p class="prose-brand mt-4">Scroll the menu, pick a course from anywhere in the world, and tee off. No rain delays, ever.</p>
        </div>
        <Photo slot="sim-courses" alt="The simulator's course selection menu showing tree-lined courses" />
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div class="card p-6">
          <h2 class="h-card">Play a real course</h2>
          <p class="mt-3 leading-relaxed">Pick from 150,000+ courses and play a full round, indoors, in any weather.</p>
        </div>
        <div class="card p-6">
          <h2 class="h-card">Range and challenges</h2>
          <p class="mt-3 leading-relaxed">Work on your swing at the driving range, or go head-to-head in challenge modes.</p>
        </div>
        <div class="card p-6">
          <h2 class="h-card">Bring the group</h2>
          <p class="mt-3 leading-relaxed">Up to 8 players per booth. Scramble and alternate shot formats are optional.</p>
        </div>
      </div>
      {/* TODO: owner to confirm simulator brand (Uneekor?) before naming it on the site */}
    </div>
  </section>

  <section class="section" id="prices">
    <div class="container-brand grid items-start gap-10 md:grid-cols-2">
      <div>
        <h2 class="h-section">Golf sim prices</h2>
        <p class="prose-brand mt-4">Rent the whole booth by the hour, or grab a half hour at the range.</p>
        <div class="mt-8"><PriceGroup id="golf" showTitle={false} /></div>
        <p class="mt-6"><a href={url("/pricing")} class="font-display text-sm font-bold underline decoration-[3px] underline-offset-4">All prices →</a></p>
      </div>
      <Photo slot="golf-range" alt="An open golf simulator bay with turf, hitting mat, and course on screen" />
    </div>
  </section>

  <section class="section border-y-[3px] border-ink bg-league text-paper">
    <div class="container-brand flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="label font-bold text-gold">Winter leagues</p>
        <h2 class="h-section mt-3">Keep your game going.</h2>
        <p class="prose-brand mt-3">Winter golf leagues run on the simulators. Beer and wine for adults.</p>
      </div>
      <a href={url("/leagues")} class="btn-primary">League details</a>
    </div>
  </section>

  <section class="section">
    <div class="container-brand flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="h-section">Golf sim party</h2>
        <p class="prose-brand mt-3">One booth for 2 hours, 2 large cheese pizzas, and a 2-liter soda. $99.99. Best for 8 or fewer.</p>
      </div>
      <a href={url("/parties")} class="btn-primary">Party packages</a>
    </div>
  </section>
</Base>
