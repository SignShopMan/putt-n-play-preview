---
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Putt & Play" description="That page lipped out. Head back to the Putt & Play home page.">
  <section class="section">
    <div class="container-brand text-center">
      <span class="pill bg-flag text-paper">404</span>
      <h1 class="h-hero mt-5">That one lipped out.</h1>
      <p class="prose-brand mx-auto mt-6">We couldn't find that page. Take a mulligan.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={url("/")} class="btn-primary">Back to home</a>
        <a href={url("/visit")} class="btn-secondary">Hours and directions</a>
      </div>
    </div>
  </section>
</Base>
