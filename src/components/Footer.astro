---
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import nav from "../data/nav.json";
import business from "../data/business.json";
import { groupedHours } from "../lib/hours";
const a = business.address;
---

<footer class="border-t-[3px] border-ink bg-paper px-4 py-14 sm:px-6">
  <div class="container-brand grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href={url("/")} aria-label="Putt & Play home"><Logo class="w-[200px]" /></a>
      <p class="mt-4 text-sm leading-relaxed">Indoor fun, all year long. Family-owned in downtown Bellefontaine.</p>
    </div>

    <div>
      <h2 class="label font-bold">Visit</h2>
      <address class="mt-3 not-italic leading-relaxed">
        {a.street}<br />{a.city}, {a.region} {a.postalCode}
      </address>
      <p class="mt-3"><a href={business.phoneHref} class="font-semibold underline underline-offset-2">{business.phone}</a></p>
      {/* TODO: verify email with owner */}
      <p><a href={`mailto:${business.email}`} class="underline underline-offset-2">{business.email}</a></p>
    </div>

    <div>
      <h2 class="label font-bold" id="footer-hours">Hours</h2>
      {/* TODO: hours not yet verified by owner */}
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        {groupedHours().map((g) => (<><dt class="font-semibold">{g.label}</dt><dd>{g.value}</dd></>))}
      </dl>
    </div>

    <div>
      <h2 class="label font-bold">Explore</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1">
        {nav.map((n) => <li><a href={url(n.href)} class="hover:underline">{n.label}</a></li>)}
      </ul>
      <ul class="mt-4 flex flex-wrap gap-2">
        <li><a href={business.links.giftCards} class="pill bg-gold" rel="noopener" target="_blank">Gift cards</a></li>
        <li><a href={business.links.tour} class="pill bg-paper" rel="noopener" target="_blank">3D tour</a></li>
        <li><a href={business.links.facebook} class="pill bg-paper" rel="noopener" target="_blank">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="container-brand mt-12 flex flex-wrap justify-between gap-2 border-t-[3px] border-ink pt-6 text-sm">
    <p>© {new Date().getFullYear()} {business.name}</p>
    <p>{a.street}, {a.city}, {a.region}</p>
  </div>
</footer>
