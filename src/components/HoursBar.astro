---
import { url } from "../lib/url";
import { hours, formatDay, groupedHours } from "../lib/hours";
import business from "../data/business.json";
// Pre-render every day's text; a tiny script swaps in today's (static site, visitor's local day).
const byDay = hours.days.map((d) => formatDay(d));
const summary = groupedHours().filter((g) => g.value !== "Closed").map((g) => `${g.label} ${g.value}`).join(" · ");
---

<div class="border-b-[3px] border-ink bg-ink px-4 py-2 text-paper sm:px-6">
  {/* TODO: hours not yet verified by owner (src/data/hours.json) */}
  <div class="container-brand flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-sm">
    <p>
      <span class="label font-bold text-gold">Today</span>
      <span id="hours-today" data-hours={JSON.stringify(byDay)} class="ml-2 font-semibold">
        {summary}
      </span>
      <a href={url("/visit#hours")} class="ml-2 underline underline-offset-2 hover:text-gold">All hours</a>
    </p>
    <p class="hidden sm:block">
      {business.address.street}, {business.address.city} ·
      <a href={business.phoneHref} class="font-semibold underline underline-offset-2 hover:text-gold">{business.phone}</a>
    </p>
  </div>
</div>

<script>
  const el = document.getElementById("hours-today");
  if (el?.dataset.hours) {
    const days: string[] = JSON.parse(el.dataset.hours);
    const today = days[new Date().getDay()];
    el.textContent = today === "Closed" ? "Closed today" : `Open ${today}`;
  }
</script>
