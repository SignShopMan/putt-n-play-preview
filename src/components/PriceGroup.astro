---
import pricing from "../data/pricing.json";
import { strip, type BrandColor } from "../lib/colors";

interface Props {
  id: string;
  showTitle?: boolean;
  headingLevel?: "h2" | "h3";
}
const { id, showTitle = true, headingLevel = "h3" } = Astro.props;
const group = pricing.groups.find((g) => g.id === id);
if (!group) throw new Error(`Unknown price group: ${id}`);
const H = headingLevel;
---

{/* TODO: all prices unverified — confirm with owner (src/data/pricing.json) */}
<div class="card" id={`price-${group.id}`}>
  <div class:list={["h-4 border-b-[3px] border-ink", strip[group.color as BrandColor]]} aria-hidden="true"></div>
  <div class="p-5 md:p-6">
    {showTitle && <H class="h-card">{group.name}</H>}
    <ul class:list={["divide-y-2 divide-ink/10", showTitle && "mt-4"]}>
      {
        group.items.map((item) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
            <div class="min-w-0 flex-1 basis-56">
              <p class="font-semibold">{item.name}</p>
              {"note" in item && item.note && <p class="text-sm text-ink/75">{item.note}</p>}
            </div>
            <div class="text-right">
              <p>
                <span class="price">{item.price}</span>
                {"unit" in item && item.unit && <span class="ml-1 text-sm">{item.unit}</span>}
              </p>
              {"alt" in item && item.alt && <p class="text-sm">{item.alt}</p>}
            </div>
          </li>
        ))
      }
    </ul>
    {"note" in group && group.note && <p class="mt-3 text-sm text-ink/75">{group.note}</p>}
  </div>
</div>
