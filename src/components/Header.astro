---
import { url } from "../lib/url";
import Logo from "./Logo.astro";
import HoursBar from "./HoursBar.astro";
import nav from "../data/nav.json";
import business from "../data/business.json";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === url(href) || path.startsWith(url(href) + "/");
---

<header class="relative z-50">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn-primary">Skip to content</a>
  <HoursBar />
  <div class="border-b-[3px] border-ink bg-paper px-4 sm:px-6">
    <div class="container-brand flex items-center justify-between gap-4 py-3">
      <a href={url("/")} class="shrink-0" aria-label="Putt & Play home">
        <Logo class="w-[160px] md:w-[210px]" eager />
      </a>

      <nav aria-label="Main" class="hidden xl:block">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-11 items-center rounded-full border-[3px] px-3 font-display text-xs font-bold whitespace-nowrap",
                    isActive(item.href) ? "border-ink bg-gold" : "border-transparent hover:border-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={business.phoneHref} class="btn-secondary !px-3 xl:hidden" aria-label={`Call ${business.phone}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
          <span class="hidden sm:inline">Call</span>
        </a>
        <a href={url("/parties")} class="btn-primary hidden sm:inline-flex">Book a party</a>
        <button
          id="menu-toggle"
          type="button"
          class="btn-secondary !px-3 xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" aria-label="Mobile" class="container-brand hidden pb-5 xl:hidden">
      <ul class="grid gap-2 sm:grid-cols-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "flex min-h-11 items-center rounded-full border-[3px] border-ink px-5 font-display text-sm font-bold",
                  isActive(item.href) ? "bg-gold" : "bg-paper",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="sm:hidden"><a href={url("/parties")} class="btn-primary w-full">Book a party</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("hidden", open);
  });
</script>
